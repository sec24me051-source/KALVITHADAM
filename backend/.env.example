# Server Port (Local standalone execution)
PORT=5000

# Data is stored in Netlify Database (managed Postgres), which is configured
# automatically on Netlify. Run locally with `netlify dev` to get a database connection.

# JWT Secret Key for Authentication Tokens (optional: a secret is generated
# and stored in the database when this is not set)
JWT_SECRET=your_jwt_secret_key_here

# Node Environment ('development' or 'production')
NODE_ENV=production

# Frontend Origin URL (Optional, for CORS in standalone deployment)
FRONTEND_URL=https://your-site-name.netlify.app
