# Server Port (Local standalone execution)
PORT=5000

# MongoDB Connection String (MongoDB Atlas URI in production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/digital-education-platform?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/digital-education-platform?retryWrites=true&w=majority

# JWT Secret Key for Authentication Tokens
JWT_SECRET=your_jwt_secret_key_here

# Node Environment ('development' or 'production')
NODE_ENV=production

# Frontend Origin URL (Optional, for CORS in standalone deployment)
FRONTEND_URL=https://your-site-name.netlify.app
